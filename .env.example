NODE_ENV=development
PORT=4500
DATABASE_URL=mongodb://mongodb:27017/photo_studio_automation
APP_URL=http://localhost:4500
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_RESET_TTL_MINUTES=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4500/api/auth/google/callback
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_API_BASE_URL=https://www.googleapis.com/drive/v3


SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES=100
SMTP_SEND_TIMEOUT_MS=60000
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
EMAIL_PROVIDER=smtp
EMAIL_FROM="Studio <verified-sender@yourdomain.com>"
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=

PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

STUDIO_AUTOMATION_ENABLED=true
STUDIO_RECONCILE_INTERVAL_MS=15000
STUDIO_WORKER_INTERVAL_MS=5000
STUDIO_DELIVERY_BATCH_SIZE=25
STUDIO_DELIVERY_MAX_RETRIES=5
STUDIO_DELIVERY_RETRY_BASE_MS=60000
STUDIO_DRIVE_VALIDATE_ON_SAVE=true
SLACK_WEBHOOK_URL=
WHATSAPP_WEBHOOK_URL=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
LOG_LEVEL=info
