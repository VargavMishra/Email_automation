generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
}

enum PaymentProvider {
  RAZORPAY
  MOCK
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum ProjectStatus {
  DRAFT
  GENERATED
}

enum StudioProjectStatus {
  EDITING
  REVIEW
  COMPLETED
  HOLD
}

enum DeliveryTone {
  FORMAL
  FRIENDLY
  PREMIUM
}

enum DeliveryDispatchStatus {
  PENDING
  PROCESSING
  RETRYABLE
  SENT
  FAILED
  SKIPPED
}

enum DeliverySendMode {
  AUTOMATED
  MANUAL
}

enum EmailLogStatus {
  QUEUED
  SENT
  FAILED
  OPENED
  CLICKED
}

enum ProjectActivityType {
  NOTE
  STATUS_UPDATED
  FOLLOW_UP_SENT
  DELIVERY_QUEUED
  DELIVERY_SENT
  DELIVERY_FAILED
  DEADLINE_EXTENDED
}

model User {
  id                     String        @id @default(auto()) @map("_id") @db.ObjectId
  email                  String        @unique
  name                   String?
  passwordHash           String?
  role                   Role          @default(USER)
  googleId               String?       
  refreshTokenHash       String?
  resetTokenHash         String?
  resetTokenExpiresAt    DateTime?
  emailVerifiedAt        DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  subscription           Subscription?
  payments               Payment[]
  projects               Project[]
  studioClients          StudioClient[]         @relation("StudioClientOwner")
  studioProjects         StudioProject[]        @relation("StudioProjectOwner")
  studioActivities       StudioProjectActivity[] @relation("StudioActivityAuthor")
}

model Subscription {
  id                 String             @id @default(auto()) @map("_id") @db.ObjectId
  userId             String             @unique @db.ObjectId
  plan               Plan               @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now())
  currentPeriodEnd   DateTime?
  provider           PaymentProvider    @default(MOCK)
  providerCustomerId String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user               User               @relation(fields: [userId], references: [id])
}

model Payment {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  userId            String          @db.ObjectId
  provider          PaymentProvider
  status            PaymentStatus   @default(CREATED)
  plan              Plan
  amount            Int
  currency          String          @default("INR")
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user              User            @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Project {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  userId          String        @db.ObjectId
  name            String
  slug            String
  status          ProjectStatus @default(DRAFT)
  featureConfig   Json
  lastGeneratedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])

  @@index([userId])
}

model StudioClient {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  ownerId      String?          @db.ObjectId
  name         String
  brandName    String
  email        String
  phone        String?
  priorityTier String           @default("STANDARD")
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  owner        User?            @relation("StudioClientOwner", fields: [ownerId], references: [id])
  projects     StudioProject[]
  emailLogs    DeliveryEmailLog[]

  @@index([ownerId])
  @@index([email])
  @@index([brandName])
}

model StudioProject {
  id                   String               @id @default(auto()) @map("_id") @db.ObjectId
  clientId             String               @db.ObjectId
  ownerId              String?              @db.ObjectId
  projectCode          String               @unique
  title                String
  status               StudioProjectStatus  @default(EDITING)
  requiresFollowUp     Boolean              @default(false)
  followUpSentAt       DateTime?
  deliveryEmailSent    Boolean              @default(false)
  deliverySentAt       DateTime?
  deliveryTemplateTone DeliveryTone         @default(FORMAL)
  driveFolderLink      String
  driveFolderId        String?
  driveValidatedAt     DateTime?
  driveShareMode       String?
  deadlineAt           DateTime?
  notes                String?
  metadata             Json?
  lastEligibilityCheckAt DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  client               StudioClient         @relation(fields: [clientId], references: [id])
  owner                User?                @relation("StudioProjectOwner", fields: [ownerId], references: [id])
  dispatch             DeliveryDispatch?
  emailLogs            DeliveryEmailLog[]
  activities           StudioProjectActivity[]

  @@index([clientId])
  @@index([ownerId])
  @@index([status, deliveryEmailSent])
  @@index([followUpSentAt])
}

model DeliveryDispatch {
  id                  String                 @id @default(auto()) @map("_id") @db.ObjectId
  projectId           String                 @unique @db.ObjectId
  status              DeliveryDispatchStatus @default(PENDING)
  attempts            Int                    @default(0)
  maxAttempts         Int                    @default(5)
  nextAttemptAt       DateTime               @default(now())
  lockedAt            DateTime?
  lockedBy            String?
  lastError           String?
  lastResponseMessage String?
  lastProcessedAt     DateTime?
  sentAt              DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  project             StudioProject          @relation(fields: [projectId], references: [id])
  emailLogs           DeliveryEmailLog[]

  @@index([status, nextAttemptAt])
}

model DeliveryEmailLog {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  projectId         String          @db.ObjectId
  clientId          String          @db.ObjectId
  dispatchId        String?         @db.ObjectId
  recipientEmail    String
  subject           String
  htmlSnapshot      String
  textSnapshot      String
  tone              DeliveryTone
  sendMode          DeliverySendMode @default(AUTOMATED)
  provider          String
  providerMessageId String?
  status            EmailLogStatus   @default(QUEUED)
  openTrackingToken String           @unique
  clickTrackingToken String          @unique
  openedAt          DateTime?
  clickedAt         DateTime?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  project           StudioProject    @relation(fields: [projectId], references: [id])
  client            StudioClient     @relation(fields: [clientId], references: [id])
  dispatch          DeliveryDispatch? @relation(fields: [dispatchId], references: [id])

  @@index([projectId, status])
  @@index([recipientEmail])
  @@index([createdAt])
}

model StudioProjectActivity {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  projectId   String              @db.ObjectId
  createdById String?             @db.ObjectId
  type        ProjectActivityType
  message     String
  metadata    Json?
  createdAt   DateTime            @default(now())

  project     StudioProject       @relation(fields: [projectId], references: [id])
  createdBy   User?               @relation("StudioActivityAuthor", fields: [createdById], references: [id])

  @@index([projectId, createdAt])
}
